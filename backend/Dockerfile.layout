FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-layout.txt ./
RUN pip install --no-cache-dir -r requirements-layout.txt
COPY app ./app
COPY scripts ./scripts
RUN mkdir -p /home/app /output && chown -R 10001:10001 /home/app /output /app
USER 10001
ENV HOME=/home/app
ENTRYPOINT ["python", "scripts/layout_runner.py"]
