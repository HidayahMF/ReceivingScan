FROM python:3.10-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DISABLE_MODEL_SOURCE_CHECK=True
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-ocr-compat-legacy.txt ./
RUN pip install --no-cache-dir -r requirements-ocr-compat-legacy.txt
COPY app ./app
COPY scripts ./scripts
RUN mkdir -p /models /home/app /tmp/receiving-ai && chown -R 10001:10001 /models /home/app /tmp/receiving-ai /app
USER 10001
ENV HOME=/home/app TMPDIR=/tmp/receiving-ai PADDLE_HOME=/models/paddle
ENTRYPOINT ["python", "scripts/ocr_compat_legacy.py"]
